{
  "version": 1,
  "comment": "Default rules. Each redact rule blocks a command that is likely to print secrets unless it is already piped through the redactor. 'match' regexes run per line on the lower-cased command; with several, all must match (on any line).",
  "redact_rules": [
    {"id": "systemctl-cat-show", "why": "systemctl cat/show can print Environment= lines with secrets", "match": ["\\bsystemctl\\s+(--user\\s+)?(cat|show)\\b"]},
    {"id": "journalctl-unit", "why": "journalctl -u can contain environment dumps with secrets", "match": ["\\bjournalctl\\s.*(-u|--unit)\\s"]},
    {"id": "read-env-file", "why": "reading an env, secrets or unit file directly can print secrets", "match": ["\\b(cat|less|more|head|tail|bat|view)\\b[^|;&]*?(\\.env(\\b|\\s)|/etc/[\\w.-]*secrets[\\w.-]*/|\\.service(\\.|\\s|$)|override\\.conf|dropin\\.conf|environment-file|envfile|\\.envrc)"], "unless": ["\\.env\\.(example|sample|template|dist)\\b", "(^|[^2\\d&])>\\s*/dev/null(\\s|$)"]},
    {"id": "printenv", "why": "printenv dumps the whole environment", "match": ["(^|[\\s&|;]|\\$\\()printenv\\s*($|[&|;>)])"]},
    {"id": "env-dump", "why": "a bare env dumps the whole environment", "match": ["(^|[\\s&|;/])env(\\s*$|\\s*\\||\\s*>)"]},
    {"id": "docker-inspect", "why": "docker inspect prints the container's Env[]", "match": ["\\bdocker\\s+inspect\\b"]},
    {"id": "docker-exec-env", "why": "docker exec is running env/printenv or reading a secrets file", "match": ["\\bdocker\\s+exec\\b.*\\b(env|printenv|cat\\s+\\.env|cat\\s+/etc/secrets)"]},
    {"id": "kubectl-secret", "why": "kubectl get/describe secret exposes base64 values", "match": ["\\bkubectl\\s+(get|describe)\\s+secret"]},
    {"id": "ssh-remote-secret", "why": "ssh is running a command that can print secrets on the remote side", "match": ["\\bssh\\b", "(systemctl\\s+(cat|show)|journalctl\\s.*(-u|--unit)|printenv\\b|\\benv\\s*$|\\benv\\s*\\||(cat|less|more|head|tail|bat|view)\\s+[^|;&]*?(\\.env|/etc/[\\w.-]*secrets[\\w.-]*/|override\\.conf|\\.envrc)|docker\\s+inspect|kubectl\\s+(get|describe)\\s+secret)"]},
    {"id": "proc-environ", "why": "reading /proc/<pid>/environ or cmdline can print another process's environment or arguments", "match": ["/proc/[^\\s]*/(environ|cmdline)"]},
    {"id": "ps-environment", "why": "ps with environment output (ps e, auxe, ewww) prints every process's environment", "match": ["\\bps\\s+-?[a-z]*e[a-z]*w[a-z]*\\b|\\bps\\s+-?[a-z]*w[a-z]*e\\b|\\bps\\s+[a-z]*aux[a-z]*e\\b"]},
    {"id": "docker-compose-config", "why": "docker compose config prints the resolved environment of every service", "match": ["\\bdocker[ -]compose\\b.*\\bconfig\\b"]},
    {"id": "kubectl-config-raw", "why": "kubectl config view --raw prints cluster tokens and client keys", "match": ["\\bkubectl\\s+config\\s+view\\b.*--raw"]},
    {"id": "kubectl-exec-env", "why": "kubectl exec running env/printenv prints a pod's environment", "match": ["\\bkubectl\\s+exec\\b.*\\b(env|printenv)\\b"]},
    {"id": "aws-print-credentials", "why": "this aws command prints credentials, tokens or secret values", "match": ["\\baws\\s+(configure\\s+(export-credentials|get\\b)|sts\\s+(get-session-token|assume-role)|secretsmanager\\s+get-secret-value|ssm\\s+get-parameters?\\b.*--with-decryption|ecr\\s+get-login-password|codeartifact\\s+get-authorization-token|eks\\s+get-token|lambda\\s+get-function-configuration)"]},
    {"id": "gcloud-print-token", "why": "this gcloud command prints an access token or a secret value", "match": ["\\bgcloud\\s+(auth\\s+(application-default\\s+)?print-(access|identity)-token|secrets\\s+versions\\s+access|config\\s+config-helper)"]},
    {"id": "azure-print-credentials", "why": "this az command prints a token, key or secret", "match": ["\\baz\\s+(account\\s+get-access-token|keyvault\\s+secret\\s+(show|download)|ad\\s+sp\\s+create-for-rbac|storage\\s+account\\s+(keys\\s+list|show-connection-string)|(webapp|functionapp)\\s+config\\s+appsettings\\s+list|acr\\s+credential\\s+show)"]},
    {"id": "gh-print-token", "why": "gh can print the stored GitHub token", "match": ["\\bgh\\s+auth\\s+(token\\b|status\\b.*(-t\\b|--show-token))"]},
    {"id": "git-config-list", "why": "git config --list can print credentials and tokens stored in git config", "match": ["\\bgit\\s+config\\s+(--?[a-z-]+\\s+)*(-l|--list)\\b|\\bgit\\s+config\\s+(--?[a-z-]+\\s+)*--get\\S*\\s+\\S*(token|password|credential)|\\bgit\\s+credential\\s+fill\\b"]},
    {"id": "read-credential-file", "why": "reading a credential store, key file or token file directly can print secrets", "match": ["\\b(?:cat|less|more|head|tail|bat|view|strings|xxd|od|nl|tac|grep|egrep|rg|sed|awk|jq|yq|base64)\\b[^|;&]*?(\\.aws/(credentials|config)|\\.netrc\\b|\\.npmrc\\b|\\.pypirc|\\.docker/config\\.json|\\.dockercfg|\\.kube/config|\\.git-credentials|\\.pgpass|\\.my\\.cnf|\\.s3cfg|\\.boto\\b|\\.vault-token|\\.terraformrc|credentials\\.tfrc\\.json|\\.config/(gcloud|gh/hosts\\.yml|rclone|doctl|op/|tailscale|glab-cli|hub)|application_default_credentials\\.json|\\.azure/|\\.ssh/id_[a-z0-9_]+|\\bid_(rsa|ed25519|ecdsa|dsa)\\b|\\.gnupg/|\\.tfstate\\b|\\.p12\\b|\\.pfx\\b|\\.htpasswd|wp-config\\.php|service[-_]?account[\\w.-]*\\.json|secrets?\\.ya?ml)"], "unless": ["\\.(pub|example|sample)\\b", "(^|[^2\\d&])>\\s*/dev/null(\\s|$)"]},
    {"id": "shell-history", "why": "shell history files and the history builtin often contain pasted secrets", "match": ["\\b(cat|less|more|head|tail|bat|grep|egrep|rg|sed|awk|strings|nl|tac)\\b[^|;&]*?(\\.bash_history|\\.zsh_history|\\.zhistory|\\.histfile|fish_history|\\.python_history|\\.psql_history|\\.mysql_history|\\.node_repl_history|\\.sqlite_history|\\.rediscli_history|\\.irb_history|\\.lesshst|\\.viminfo)|(^|[;&|(])\\s*history(\\s|$)|(^|[;&|(])\\s*fc\\s+-[a-z]*l"]},
    {"id": "terraform-output", "why": "terraform/tofu output, show, state pull and console print state values, which can hold secrets", "match": ["\\b(terraform|tofu)\\s+(output|show|state\\s+(show|pull)|console)\\b|\\bpulumi\\s+(stack\\s+output|config)\\b.*--show-secrets|\\bpulumi\\s+config\\s+get\\b"]},
    {"id": "secret-manager-read", "why": "reading a secret manager prints secret values", "match": ["\\b(vault\\s+(kv\\s+get|read|token\\s+lookup)|op\\s+(read|item\\s+get|inject)|bw\\s+get\\s+(password|item|totp|notes)|pass\\s+show|gopass\\s+show|sops\\s+(-d|--decrypt|decrypt)|doppler\\s+secrets\\s+(download|get)|heroku\\s+config(\\s|$)|heroku\\s+auth:token|vercel\\s+env\\s+pull|railway\\s+variables|netlify\\s+env:list|npm\\s+config\\s+(get|list|ls)|firebase\\s+login:ci|npm\\s+token\\s+(create|list)|stripe\\s+config\\s+--list|supabase\\s+projects\\s+api-keys)\\b"]},
    {"id": "headscale-key", "why": "headscale pre-auth and API keys are printed once when created or listed", "match": ["\\bheadscale\\s+(preauthkeys?|apikeys?)\\s+(create|list|expire)\\b"]},
    {"id": "compgen-env", "why": "compgen -e lists environment variable names with their values via the shell", "match": ["\\bcompgen\\s+-e\\b"]},
    {"id": "script-env-dump", "why": "an inline script that prints the whole environment", "match": ["\\b(python[0-9.]*|node|ruby|perl|php|deno|bun)\\s+(-\\w+\\s+)*(-c|-e|-p)\\b", "(os\\.environ\\s*[),]|os\\.environ\\s*[\"']|dict\\(os\\.environ|process\\.env\\s*[),]|stringify\\(process\\.env|\\bENV\\.(to_h|each)|%env\\b)"]},
    {"id": "script-reads-secret-file", "why": "an inline script reading a secrets file can print it", "match": ["\\b(python[0-9.]*|node|ruby|perl|php|lua|deno|bun)\\s+(-[a-z-]+\\s+)*-(c|e|p|r)\\s+['\\\"][^\\n]*[\\w./-]*\\.env(\\.[\\w-]+)?\\b"], "unless": ["\\.env\\.(example|sample|template|dist)\\b", "process\\.env|import\\.meta\\.env|\\bdotenv\\b"]}
  ],
  "secret_paths": [],
  "disable": [],
  "allow": []
}
